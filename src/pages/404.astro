---
// src/pages/404.astro
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 | Kulan Thamuditha</title>
    <style is:global>
      @keyframes float404 {
        0%, 100% { transform: translateY(0) rotate(-2deg); }
        50% { transform: translateY(-14px) rotate(2deg); }
      }
      @keyframes glitch {
        0%, 90%, 100% { transform: translate(0); text-shadow: none; }
        92% { transform: translate(-3px, 1px); text-shadow: 3px 0 #06b6d4, -3px 0 #6366f1; }
        94% { transform: translate(3px, -1px); text-shadow: -3px 0 #06b6d4, 3px 0 #6366f1; }
        96% { transform: translate(-2px, 0); text-shadow: 2px 0 #06b6d4, -2px 0 #6366f1; }
      }
      @keyframes caretBlink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
      @keyframes riseIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .bug { animation: float404 4s ease-in-out infinite; display: inline-block; }
      .glitch { animation: glitch 4s infinite; }
      .rise { opacity: 0; animation: riseIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
      .caret {
        display: inline-block; width: 8px; height: 1em; margin-left: 2px;
        vertical-align: -0.15em; background: #a5b4fc; animation: caretBlink 1s steps(1) infinite;
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; }
      }
    </style>
  </head>
  <body class="min-h-screen flex items-center justify-center px-6 text-white font-sans antialiased" style="background:#070d1c;">

    <!-- Grid overlay -->
    <div class="fixed inset-0 pointer-events-none" style="background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px); background-size: 52px 52px;"></div>
    <div class="fixed -top-24 -left-24 w-96 h-96 rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(99,102,241,0.2), transparent 70%);"></div>
    <div class="fixed -bottom-24 -right-24 w-96 h-96 rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(59,130,246,0.18), transparent 70%);"></div>

    <main class="relative z-10 max-w-xl w-full text-center">

      <div class="bug text-6xl mb-4" aria-hidden="true">🐛</div>

      <h1 class="glitch text-7xl md:text-8xl font-extrabold tracking-tight mb-3 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300">
        404
      </h1>

      <p class="rise text-xl md:text-2xl font-semibold mb-8" style="animation-delay:0.2s;">
        HTTP 404: This page went to production without testing.
      </p>

      <div class="rise text-left rounded-xl overflow-hidden shadow-2xl mb-8" style="background:#0b1224;border:1px solid rgba(255,255,255,0.1);animation-delay:0.4s;">
        <div class="flex items-center gap-2 px-4 py-2" style="background:#0f1830;border-bottom:1px solid rgba(255,255,255,0.08);">
          <span class="w-3 h-3 rounded-full" style="background:#ef4444cc;"></span>
          <span class="w-3 h-3 rounded-full" style="background:#f59e0bcc;"></span>
          <span class="w-3 h-3 rounded-full" style="background:#10b981cc;"></span>
          <span class="ml-3 text-xs" style="color:rgba(255,255,255,0.35);font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;">kulan@portfolio: ~</span>
        </div>
        <div class="p-4 text-sm leading-relaxed" style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;color:rgba(255,255,255,0.6);">
          <div><span style="color:#34d399;">$</span> <span style="color:#a5b4fc;">git blame this-page.astro</span></div>
          <div>fatal: no such page. It was me. (Or the cache.)</div>
          <div><span style="color:#34d399;">$</span> <span style="color:#a5b4fc;">cd ~</span><span class="caret"></span></div>
        </div>
      </div>

      <a href="/"
        class="rise inline-block bg-blue-600 text-white px-8 py-3 rounded-xl font-semibold hover:bg-blue-500 hover:-translate-y-1 transition-all shadow-lg"
        style="animation-delay:0.6s;">
        Take me home
      </a>

    </main>
  </body>
</html>