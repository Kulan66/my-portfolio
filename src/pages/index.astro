<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

  /* ---------- ⌨️ Typewriter hero line ---------- */
  const tw = document.getElementById('typewriter');
  if (tw && !reduce) {
    const phrases = [
      'Building robust enterprise systems.',
      'Fixing prod at 2 AM.',
      'Turning coffee into APIs.',
      'Blaming the cache.',
    ];
    let p = 0;
    let c = phrases[0].length;
    let deleting = true;
    const tick = () => {
      const full = phrases[p];
      if (!deleting) {
        c++;
        tw.textContent = full.slice(0, c);
        if (c === full.length) { deleting = true; return setTimeout(tick, 1900); }
        return setTimeout(tick, 60);
      }
      c--;
      tw.textContent = full.slice(0, c);
      if (c === 0) { deleting = false; p = (p + 1) % phrases.length; return setTimeout(tick, 350); }
      setTimeout(tick, 28);
    };
    setTimeout(tick, 2600);
  }

  /* ---------- 🟢 Status badge rotation ---------- */
  const status = document.getElementById('status-text');
  if (status && !reduce) {
    const msgs = ["Currently: fixing bugs I didn't write", 'Open to opportunities'];
    let s = 0;
    setInterval(() => {
      status.style.opacity = '0';
      setTimeout(() => {
        s = (s + 1) % msgs.length;
        status.textContent = msgs[s];
        status.style.opacity = '1';
      }, 300);
    }, 3800);
  }

  /* ---------- 🖱️ Cursor trail (hero only) ---------- */
  const hero = document.getElementById('hero');
  const trail = document.getElementById('trail');
  if (hero && trail && !reduce) {
    const syms = ['{ }', '</>', '=>', ';', '01', '()', '[]', '//'];
    let last = 0, lx = -100, ly = -100;
    hero.addEventListener('mousemove', (e) => {
      const now = performance.now();
      if (now - last < 45) return;
      const r = hero.getBoundingClientRect();
      const x = e.clientX - r.left;
      const y = e.clientY - r.top;
      if (Math.hypot(x - lx, y - ly) < 14) return;
      last = now; lx = x; ly = y;
      const s = document.createElement('span');
      s.className = 'trail-sym';
      s.textContent = syms[Math.floor(Math.random() * syms.length)];
      s.style.left = x + 'px';
      s.style.top = y + 'px';
      s.style.fontSize = 10 + Math.random() * 6 + 'px';
      s.style.setProperty('--dx', Math.random() * 40 - 20 + 'px');
      trail.appendChild(s);
      setTimeout(() => s.remove(), 900);
    });
  }

  /* ---------- 🖥️ Fake terminal in contact section ---------- */
  const term = document.getElementById('terminal');
  if (term) {
    const cmdEl = document.getElementById('term-cmd');
    const lines = term.querySelectorAll('.term-line');
    const btns = document.getElementById('term-buttons');
    const cmd = `git commit -m "let's work together"`;
    let started = false;
    const run = async () => {
      cmdEl.textContent = '';
      for (const ch of cmd) { cmdEl.textContent += ch; await sleep(reduce ? 0 : 55); }
      for (const l of lines) { await sleep(reduce ? 0 : 380); l.classList.add('show'); }
      await sleep(reduce ? 0 : 400);
      btns.classList.add('show');
    };
    new IntersectionObserver((entries, obs) => {
      if (entries[0].isIntersecting && !started) { started = true; obs.disconnect(); run(); }
    }, { threshold: 0.5 }).observe(term);
  }

  /* ---------- 🎉 Confetti ---------- */
  function confetti() {
    const cv = document.getElementById('confetti');
    if (!cv || reduce) return;
    const ctx = cv.getContext('2d');
    cv.width = window.innerWidth;
    cv.height = window.innerHeight;
    const colors = ['#2563eb', '#06b6d4', '#6366f1', '#f59e0b', '#10b981', '#ef4444'];
    const parts = Array.from({ length: 150 }, () => ({
      x: Math.random() * cv.width,
      y: -20 - Math.random() * cv.height * 0.5,
      r: 4 + Math.random() * 5,
      c: colors[Math.floor(Math.random() * colors.length)],
      vx: -2 + Math.random() * 4,
      vy: 2 + Math.random() * 4,
      rot: Math.random() * 6,
      vr: -0.2 + Math.random() * 0.4,
    }));
    let frames = 0;
    (function draw() {
      ctx.clearRect(0, 0, cv.width, cv.height);
      parts.forEach((q) => {
        q.x += q.vx; q.y += q.vy; q.rot += q.vr;
        ctx.save();
        ctx.translate(q.x, q.y);
        ctx.rotate(q.rot);
        ctx.fillStyle = q.c;
        ctx.fillRect(-q.r, -q.r / 2, q.r * 2, q.r);
        ctx.restore();
      });
      if (++frames < 260) requestAnimationFrame(draw);
      else ctx.clearRect(0, 0, cv.width, cv.height);
    })();
  }

  /* ---------- 🥚 Easter egg: sudo hire kulan ---------- */
  const egg = document.getElementById('egg');
  const eggOut = document.getElementById('egg-out');
  let eggToken = 0;
  async function openEgg() {
    const my = ++eggToken;
    egg.classList.remove('hidden');
    egg.classList.add('flex');
    eggOut.textContent = '';
    confetti();
    for (const ch of '$ sudo hire kulan') {
      if (my !== eggToken) return;
      eggOut.textContent += ch;
      await sleep(reduce ? 0 : 60);
    }
    const rest = [
      '\n[sudo] password for recruiter: ********',
      'Verifying skills.......... OK',
      'Checking coffee supply.... OK',
      'Bugs in production........ 0 (probably)',
      '\n✔ Access granted. Kulan has been hired! 🎉',
    ];
    for (const l of rest) {
      await sleep(reduce ? 0 : 500);
      if (my !== eggToken) return;
      eggOut.textContent += '\n' + l;
    }
    confetti();
  }
  function closeEgg() {
    eggToken++;
    egg.classList.add('hidden');
    egg.classList.remove('flex');
  }
  document.getElementById('egg-close')?.addEventListener('click', closeEgg);
  egg?.addEventListener('click', (e) => { if (e.target === egg) closeEgg(); });

  // Trigger 1: click the logo 3 times quickly
  let logoClicks = [];
  document.getElementById('logo')?.addEventListener('click', () => {
    const now = Date.now();
    logoClicks = logoClicks.filter((t) => now - t < 1500);
    logoClicks.push(now);
    if (logoClicks.length >= 3) { logoClicks = []; openEgg(); }
  });

  // Trigger 2: Konami code
  const konami = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
  let kBuf = [];
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { setOpen(false); closeEgg(); return; }
    kBuf.push(e.key.length === 1 ? e.key.toLowerCase() : e.key);
    kBuf = kBuf.slice(-konami.length);
    if (kBuf.join() === konami.join()) { kBuf = []; openEgg(); }
  });

  /* ---------- 🐱 Mascot avatar reactions ---------- */
  const fab = document.getElementById('connect-fab');
  const toggle = document.getElementById('connect-toggle');
  const mascot = document.getElementById('mascot');
  const face = (eyes) =>
    'https://api.dicebear.com/9.x/avataaars/svg?seed=Kulan&backgroundColor=7e1f86' + (eyes ? '&eyes=' + eyes : '');
  const faces = { base: face(''), blink: face('closed'), wink: face('wink'), happy: face('happy') };
  Object.values(faces).forEach((u) => { const im = new Image(); im.src = u; });
  let hovering = false;
  let menuOpen = false;
  const showFace = () => {
    const u = menuOpen ? faces.happy : hovering ? faces.wink : faces.base;
    if (mascot && mascot.getAttribute('src') !== u) mascot.setAttribute('src', u);
  };
  if (mascot && !reduce) {
    const blinkLoop = async () => {
      await sleep(2800 + Math.random() * 2500);
      if (!hovering && !menuOpen) {
        mascot.setAttribute('src', faces.blink);
        await sleep(140);
        showFace();
      }
      blinkLoop();
    };
    blinkLoop();
  }
  toggle?.addEventListener('mouseenter', () => { hovering = true; showFace(); });
  toggle?.addEventListener('mouseleave', () => { hovering = false; showFace(); });
  toggle?.addEventListener('animationend', () => toggle.classList.remove('mascot-bounce'));

  const setOpen = (open) => {
    fab?.classList.toggle('open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    menuOpen = open;
    showFace();
    if (open && toggle && !reduce) {
      toggle.classList.remove('mascot-bounce');
      void toggle.offsetWidth;
      toggle.classList.add('mascot-bounce');
    }
  };

  toggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    setOpen(!fab.classList.contains('open'));
  });
  document.addEventListener('click', (e) => {
    if (fab && !fab.contains(e.target)) setOpen(false);
  });
</script>